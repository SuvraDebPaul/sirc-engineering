model Service {
  id String @id @default(uuid())

  /// Also the URL slug (/services/[slug]) and, for some services, the RFQ
  /// enquiry-type value — kept as one field rather than two that could drift.
  slug           String  @unique
  icon           String
  imageUrl       String
  title          String
  description    String
  turnaroundDays Int
  onSite         Boolean @default(true)

  /// string[] — paragraphs for "What this covers"
  overview     Json @default("[]")
  /// string[] — bullet list for "At a glance / Scope"
  scope        Json @default("[]")
  /// string[] — bullet list for "What you receive"
  deliverables Json @default("[]")
  /// { title: string, body: string }[] — numbered "How it works" steps
  process      Json @default("[]")
  /// { question: string, answer: string }[] — FAQ accordion
  faqs         Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}
